ACE_PRO_ENVIRONMENT=development
ACE_PRO_LOG_LEVEL=INFO
ACE_PRO_API_HOST=127.0.0.1
ACE_PRO_API_PORT=8000
ACE_PRO_AWS_REGION=us-west-2
ACE_PRO_DATABASE_URL=postgresql+asyncpg://ace_pro:ace_pro@127.0.0.1:5432/ace_pro
ACE_PRO_S3_BUCKET=ace-pro-videos
ACE_PRO_S3_ENDPOINT_URL=http://127.0.0.1:9000
ACE_PRO_S3_ACCESS_KEY_ID=ace-pro-local
ACE_PRO_S3_SECRET_ACCESS_KEY=ace-pro-local-secret
ACE_PRO_S3_FORCE_PATH_STYLE=true
ACE_PRO_PLAYBACK_BASE_URL=http://127.0.0.1:9000/ace-pro-videos
# Set for deployed AWS environments; leave empty for local MinIO playback.
ACE_PRO_CLOUDFRONT_DISTRIBUTION_ID=
